# Copy to .env.local from Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=

# Use either the legacy anon JWT (often labeled "anon" / "public") or the newer publishable key:
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional duplicates for server (same values as above; anon or publishable, not the service role):
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# SUPABASE_PUBLISHABLE_KEY=

# Optional: for `supabase link` / `supabase gen types` (Dashboard → Project Settings → General)
# SUPABASE_PROJECT_REF=
